// §GUI デジタル時計。画面の定義も文言も、何を出すかの判断も全部こちら側で決める。
// ホスト(Tkinter)は組み立てて、まつ ごとに呼び戻すだけ。
//
//     urayaha run clock.ura
//
// 画面の定義は Map ひとつ。キーは
//   だいめい  窓の題
//   ぶひん    部品の List。たね は もじ / ボタン / いれる
//   まつ      何ミリ秒ごとに まつとき を呼ぶか(省略可)
//   まつとき  その間隔で呼ぶ関数(省略可)

これって… ウィーヤ
これって… フゥ～ンフゥン

ヤハ！ プルャハ = "%H:%M:%S"

// いまの時刻の文字列
フゥン フゥンッ() ヤーッ
    ハァーッ フゥ～ンフゥン.イヤッハー(フゥ～ンフゥン.フゥン(), プルャハ)
ハァッ

// まつ ごとに呼ばれる。表示を書き換えるだけ
フゥン フゥンァ() ヤーッ
    ウィーヤ.ヤハ("いま", フゥンッ())
ハァッ

// 「とじる」を押されたとき
フゥン フゥンー() ヤーッ
    ウィーヤ.イヤッ()
ハァッ

イヤッハー("とけいを だします（窓を閉じると戻ってきます）")

ウィーヤ.イヤッハー({
        "だいめい": "うさぎの とけい",
        "ぶひん": [
            {"たね": "もじ", "なまえ": "いま", "ぶんめん": フゥンッ()},
            {"たね": "ボタン", "なまえ": "とじる", "ぶんめん": "イヤッ", "おしたら": フゥンー}
        ],
        "まつ": ン・プャャプン,
        "まつとき": フゥンァ
})

イヤッハー("とじました")
