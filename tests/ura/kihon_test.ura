// urayaha test から走る URAYAHA 側のテスト。
// 食い違ったら ワァーッ！ を投げる。捕まらずに落ちれば終了コードは ン・ャ(3)。

フゥン フゥンッ(ヤハァ: ワァッ, ヤハッ: ナンカッ, ヤハーッ: ナンカッ) ヤーッ
    ハァ？ ヤハッ != ヤハーッ ヤーッ
        ワァーッ！("${ヤハァ}: ${ヤハーッ} のはずが ${ヤハッ}")
    ハァッ
ハァッ

// ---- 数と算術 ----

フゥンッ("よんしんすう", ン・プルャ, ン・プルャ)
フゥンッ("たしざん", ン・プル + ン・ャ, ン・ルプ)
フゥンッ("わりざん", ン・プルル / ン・プン, ン・プル)
フゥンッ("あまり", ン・プャ % ン・ャ, ン・プ)
フゥンッ("まいなす", -ン・プャ / ン・ル, -ン・ャ)
フゥンッ("まいなすあまり", -ン・プャ % ン・ャ, -ン・プ)

// ---- 文字列 ----

ヤハ ヤハァ = "ワァ"
フゥンッ("ほかん", "${ヤハァ}……！", "ワァ……！")
フゥンッ("ながさ", "ヤハ".ン？(), ン・ル)
フゥンッ("ぜんかく", "ワァ！".ン？(), ン・ャ)

// ---- List ----

ヤハ プルャッ = [ン・プ, ン・ル, ン・ャ]
フゥンッ("けんすう", プルャッ.ン？(), ン・ャ)
フゥンッ("たたむ", プルャッ.ウラ(フゥン(ヤハッ, ヤハーッ) => ヤハッ + ヤハーッ, ン・ン), ン・プル)
プルャッ.ヤハ(ン・プン)
フゥンッ("ついか", プルャッ.ン？(), ン・プン)

// ---- Map ----

ヤハ ウララァ = {"ワァ": ン・プ}
フゥンッ("ある", ウララァ.ハァ？("ワァ"), ヤー)
フゥンッ("ない", ウララァ.ハァ？("フゥン"), イヤ)
ウララァ.ヤハ("フゥン", ン・ル)
フゥンッ("いれた", ウララァ["フゥン"], ン・ル)

// ---- Result ----

フゥン フゥンァ(ヤハッ: プルッ) ヤーッ
    ハァ？ ヤハッ == ン・ン ヤーッ
        ハァーッ ワァ…("ゼロ")
    ハァッ
    ハァーッ ヤッター(ヤハッ)
ハァッ

フゥンッ("せいこう", フゥンァ(ン・プ).ヤッタ？(), ヤー)
フゥンッ("しっぱい", フゥンァ(ン・ン).ヤッタ？(), イヤ)
フゥンッ("とりだし", フゥンァ(ン・ャ).なんとかなれーッ！(), ン・ャ)

// ---- unwrap の失敗は ダメだった… で捕まる ----

ヤハ ヤハーァ = "つかまらなかった"

なんとかなれーッ ヤーッ
    フゥンァ(ン・ン).なんとかなれーッ！()
ダメだった… -> ヤハッァ ヤーッ
    ヤハーァ = ヤハッァ
ハァッ

フゥンッ("あんらっぷしっぱい", ヤハーァ, "ゼロ")

// ---- Optional ----

ヤハ ヤハッー: プルッ? = ……
フゥンッ("なければ", ヤハッー ?? ン・ププ, ン・ププ)

イヤッハー("ヤッター")
